node_modules/
.DS_Store
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/
backups/

# Holds ADMIN_SECRET and the Home Assistant webhook id. .env.example is committed; this is not.
.env

# ~/.gitignore ignores .claude/ globally, which is what keeps .claude/worktrees/ from showing up as
# untracked in every session. A repo .gitignore outranks the global one, so these three lines carve
# out the single file we do want tracked: git will not descend into an ignored directory, so the
# directory has to be un-ignored first, its contents re-ignored, and settings.json named last.
!.claude/
.claude/*
!.claude/settings.json
