# Copy to .env beside docker-compose.yml and fill in. .env is gitignored; this file is not.

# REQUIRED. The host visits /admin/key/<this> once at the start of the night to claim the admin
# cookie. Anyone who learns it can end the game and rewrite scores, so generate it, do not invent
# it:  openssl rand -hex 24
ADMIN_SECRET=

# OPTIONAL. One fully-qualified Home Assistant webhook URL, id included. Unset is valid and means
# the treasure hunt runs without lights. Must be an INTERNAL address -- a public hostname or a
# Tailscale address is rejected by local_only, silently, with a 200 OK.
# See MM-HANDOFF.md § Wiring the treasure-hunt lights.
HA_WEBHOOK_URL=

# OPTIONAL. Which host address the container publishes on. Defaults to 127.0.0.1, which is right
# when the reverse proxy runs in the same network namespace. Nginx Proxy Manager here is
# 192.168.128.2 while the Unraid host is 192.168.129.201 -- different subnets -- so if
# bday.moeriki.com answers 502 while `curl 127.0.0.1:3040/healthz` works ON the host, the proxy
# cannot see loopback and this is the fix.
# BIND_ADDR=192.168.129.201

# Both have working defaults; set only to override.
# PORT=3040
# DATA_DIR=/data
# TZ=Europe/Brussels
